# Copiar a .env y completar con valores locales. No versionar .env.
APP_ENV=development
LOG_LEVEL=INFO

# SQLite local por defecto. La ruta relativa se resuelve contra backend/.
DATABASE_URL=sqlite:///./data/arvokta.db

# Clave de firma de JWT. Usar al menos 32 caracteres aleatorios en producción.
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-characters

# Admin inicial. Solo se crea si la tabla users está vacía.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3001

# IA local opcional (no requerida en Fase 1).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Descubrimiento con OpenStreetMap/Overpass. Respetar términos y límites.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60
OVERPASS_MAX_RETRIES=2
OVERPASS_REQUEST_DELAY_SECONDS=0.5
OVERPASS_USER_AGENT=ARVOKTA-Sales-Agent/0.1 (internal prospecting tool)

# WhatsApp / Meta. Vacío = modo consola (no envía mensajes reales).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SENDER_PHONE=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=30
FOUNDER_PHONE=

# Plantilla aprobada de Meta para el primer contacto. Vacío = sin plantilla: el
# primer contacto por Meta falla y no se envía texto libre (modo consola sigue
# funcionando como simulado).
# La plantilla aprobada debe tener dos parámetros en el body, en este orden:
# {{1}} = nombre de la empresa, {{2}} = nombre del producto.
WHATSAPP_FIRST_CONTACT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

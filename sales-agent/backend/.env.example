# Copiar a .env y completar con valores locales. No versionar .env.
APP_ENV=development
LOG_LEVEL=INFO

# SQLite local por defecto. La ruta relativa se resuelve contra backend/.
DATABASE_URL=sqlite:///./data/arvokta.db

# Clave de firma de JWT. Usar al menos 32 caracteres aleatorios en producción.
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-characters

# Admin inicial. Solo se crea si la tabla users está vacía.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3001

# IA local opcional (no requerida en Fase 1).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
